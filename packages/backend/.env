# UTXO Pilot — backend environment
# Copy this file to .env and fill in values

# Port the backend API listens on (default: 3001)
PORT=3001

# Where SQLite database file is stored (default: ./data/utxo-pilot.db)
DB_PATH=./data/utxo-pilot.db

# Default Esplora endpoint (used until user picks their own in Settings)
DEFAULT_ESPLORA_URL=https://blockstream.info/api

# Set to "true" to enable verbose request logging (never logs xpubs/addresses)
LOG_LEVEL=info
